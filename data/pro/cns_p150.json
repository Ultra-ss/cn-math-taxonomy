[{"id":"cns_p150_q101","topicId":"cns_p150","difficulty":"standard","type":"choice","prompt":"模型小车一侧车轮不转，拆解时先检查哪里最直接？","choices":[{"key":"A","text":"车顶图案"},{"key":"B","text":"包装纸大小"},{"key":"C","text":"该车轮与车轴是否被卡住"},{"key":"D","text":"车身贴纸颜色"}],"answer":"C","explanation":"车轮和车轴的连接及转动情况与行驶故障直接相关。","verify":"\"该车轮与车轴是否被卡住\"","level":"pro","origin":"original"},{"id":"cns_p150_q102","topicId":"cns_p150","difficulty":"standard","type":"choice","prompt":"拆开小车后把零件按位置编号，主要有什么作用？","choices":[{"key":"A","text":"让所有零件形状相同"},{"key":"B","text":"帮助理解连接关系并准确复装"},{"key":"C","text":"让零件质量变小"},{"key":"D","text":"保证小车永不故障"}],"answer":"B","explanation":"编号和记录位置能保存结构关系，便于分析功能和重新组装。","verify":"\"帮助理解连接关系并准确复装\"","level":"pro","origin":"original"},{"id":"cns_p150_q103","topicId":"cns_p150","difficulty":"challenge","type":"choice","prompt":"车架歪斜使车轮不能平行，最可能产生什么影响？","choices":[{"key":"A","text":"行驶方向偏斜或摩擦增大"},{"key":"B","text":"小车一定跑得更直"},{"key":"C","text":"橡皮筋弹力无限增大"},{"key":"D","text":"车轮不再需要车轴"}],"answer":"A","explanation":"车架支撑并定位车轴，结构歪斜会影响车轮转动和行驶。","verify":"\"行驶方向偏斜或摩擦增大\"","level":"pro","origin":"original"}]
