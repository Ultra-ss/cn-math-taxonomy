[{"id":"cns_p145_q101","topicId":"cns_p145","difficulty":"standard","type":"choice","prompt":"独轮车总重不变，把货物从靠近手柄处移近车轮，抬手柄会怎样？","choices":[{"key":"A","text":"通常更省力"},{"key":"B","text":"一定更费力"},{"key":"C","text":"支点消失"},{"key":"D","text":"车轮不再承重"}],"answer":"A","explanation":"车轮为支点，货物靠近支点，阻力的力臂减小，抬起手柄通常更省力。","verify":"\"通常更省力\"","level":"pro","origin":"original"},{"id":"cns_p145_q102","topicId":"cns_p145","difficulty":"standard","type":"choice","prompt":"保持货物位置不变，把独轮车手柄加长，用力方向相同，会怎样？","choices":[{"key":"A","text":"货物重力变小"},{"key":"B","text":"车轮质量变为零"},{"key":"C","text":"所需力一定增加"},{"key":"D","text":"用力点离支点更远，所需力通常减小"}],"answer":"D","explanation":"增长用力臂有利于省力，不是改变货物的重力。","verify":"\"用力点离支点更远，所需力通常减小\"","level":"pro","origin":"original"},{"id":"cns_p145_q103","topicId":"cns_p145","difficulty":"challenge","type":"choice","prompt":"独轮车轮轴处、货物处、手握处依次对应什么？","choices":[{"key":"A","text":"阻力点、用力点、支点"},{"key":"B","text":"三个位置都是支点"},{"key":"C","text":"支点、阻力点、用力点"},{"key":"D","text":"用力点、支点、阻力点"}],"answer":"C","explanation":"用独轮车抬起货物时，轮轴附近支撑转动，货物产生阻力，双手施加动力。","verify":"\"支点、阻力点、用力点\"","level":"pro","origin":"original"}]
