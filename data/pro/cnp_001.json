[{"id":"cnp_001_q101","topicId":"cnp_001","difficulty":"standard","type":"choice","prompt":"刻度尺的零刻线磨损，测量时把物体左端对齐 2.00 cm 刻线，右端示数为 8.36 cm。物体长度应记录为多少？","choices":[{"key":"A","text":"6.4 cm"},{"key":"B","text":"6.36 cm"},{"key":"C","text":"10.36 cm"},{"key":"D","text":"8.36 cm"}],"answer":"B","explanation":"测量长度取末、初刻度之差：8.36−2.00=6.36 cm。零刻线磨损不妨碍用完整刻线作起点。","verify":"\"6.36 cm\"","level":"pro","origin":"original"},{"id":"cnp_001_q102","topicId":"cnp_001","difficulty":"standard","type":"choice","prompt":"同一物体的长度用分度值 1 mm 的刻度尺测了三次。下列哪组记录符合这把尺的读数要求，且可用于取平均值？","choices":[{"key":"A","text":"12.3 cm、12.4 cm、12.3 cm"},{"key":"B","text":"12.340 cm、12.350 cm、12.340 cm"},{"key":"C","text":"12 cm、12 cm、12 cm"},{"key":"D","text":"12.34 cm、12.35 cm、12.34 cm"}],"answer":"D","explanation":"分度值 1 mm=0.1 cm，应估读到 0.01 cm。测量值有小幅差异并不说明读数错误。","verify":"\"12.34 cm、12.35 cm、12.34 cm\"","level":"pro","origin":"original"},{"id":"cnp_001_q103","topicId":"cnp_001","difficulty":"standard","type":"choice","prompt":"甲计时器显示经过 2 min 18 s，乙计时器显示经过 2.30 min。比较两段时间，正确的是","choices":[{"key":"A","text":"甲比乙长 12 s"},{"key":"B","text":"乙比甲长 12 s"},{"key":"C","text":"甲比乙长 0.12 s"},{"key":"D","text":"两段时间相等"}],"answer":"D","explanation":"2.30 min=2 min+0.30×60 s=2 min18 s，不能把小数分钟直接看成秒。","verify":"\"两段时间相等\"","level":"pro","origin":"original"},{"id":"cnp_001_q104","topicId":"cnp_001","difficulty":"challenge","type":"numeric","prompt":"五次测得同一细杆长度为 15.21、15.23、15.22、16.22、15.22 cm。检查发现 16.22 cm 是读错整厘米刻线所致，剔除它后，平均长度为多少 cm？（只填数值）","answer":"15.22","explanation":"排除明确读数错误后，(15.21+15.23+15.22+15.22)÷4=15.22 cm。","verify":"(15.21+15.23+15.22+15.22)/4","level":"pro","origin":"original"}]
