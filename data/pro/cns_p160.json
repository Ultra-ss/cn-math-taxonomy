[{"id":"cns_p160_q101","topicId":"cns_p160","difficulty":"standard","type":"choice","prompt":"某岩石有明显层状结构并含古生物痕迹，更支持哪种形成过程？","choices":[{"key":"A","text":"岩浆直接喷到空中"},{"key":"B","text":"岩石被人涂成条纹"},{"key":"C","text":"石头在水中完全消失"},{"key":"D","text":"沉积物堆积并逐渐固结"}],"answer":"D","explanation":"层理和化石等证据常有助于判断沉积岩形成过程，需综合观察。","verify":"\"沉积物堆积并逐渐固结\"","level":"pro","origin":"original"},{"id":"cns_p160_q102","topicId":"cns_p160","difficulty":"standard","type":"choice","prompt":"岩石在冷热变化和水的作用下变成小块，主要是什么过程？","choices":[{"key":"A","text":"人工冶炼"},{"key":"B","text":"植物开花"},{"key":"C","text":"风化"},{"key":"D","text":"熔化成岩浆"}],"answer":"C","explanation":"风化可使岩石破碎或性质改变，不要求岩石先熔化。","verify":"\"风化\"","level":"pro","origin":"original"},{"id":"cns_p160_q103","topicId":"cns_p160","difficulty":"challenge","type":"choice","prompt":"原有岩石在地壳内经历高温高压但没有熔成岩浆，性质发生变化，可能形成？","choices":[{"key":"A","text":"只能形成冰块"},{"key":"B","text":"变质岩"},{"key":"C","text":"一定成为生物化石"},{"key":"D","text":"只能形成松散沙粒"}],"answer":"B","explanation":"变质作用在未整体熔融的条件下改变岩石结构和性质。","verify":"\"变质岩\"","level":"pro","origin":"original"}]
