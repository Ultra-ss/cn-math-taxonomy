[{"id":"cns_p181_q101","topicId":"cns_p181","difficulty":"standard","type":"choice","prompt":"同量水分别摊在浅盘和装在窄杯里，其他条件相同，浅盘水通常更快减少，因为？","choices":[{"key":"A","text":"窄杯中的水不能蒸发"},{"key":"B","text":"水只在沸腾时减少"},{"key":"C","text":"与空气接触的水面较大"},{"key":"D","text":"浅盘让水变成新物质"}],"answer":"C","explanation":"水在通常温度下也会蒸发，较大表面积通常使蒸发更快。","verify":"\"与空气接触的水面较大\"","level":"pro","origin":"original"},{"id":"cns_p181_q102","topicId":"cns_p181","difficulty":"standard","type":"choice","prompt":"夏天湿毛巾擦手后觉得凉，主要涉及什么？","choices":[{"key":"A","text":"水分子停止运动"},{"key":"B","text":"水蒸发时从手等处吸热"},{"key":"C","text":"水蒸发时一定向手大量放热"},{"key":"D","text":"手上的水在室温下立刻结冰"}],"answer":"B","explanation":"蒸发需要吸热，可使被擦拭的表面温度降低。","verify":"\"水蒸发时从手等处吸热\"","level":"pro","origin":"original"},{"id":"cns_p181_q103","topicId":"cns_p181","difficulty":"challenge","type":"choice","prompt":"温暖湿空气遇到冷镜面出现水珠，与河水晒后减少分别属于？","choices":[{"key":"A","text":"凝结和蒸发"},{"key":"B","text":"蒸发和凝固"},{"key":"C","text":"熔化和凝固"},{"key":"D","text":"升华和熔化"}],"answer":"A","explanation":"水蒸气变液态是凝结，液态水进入空气成为水蒸气是蒸发。","verify":"\"凝结和蒸发\"","level":"pro","origin":"original"}]
