[{"id":"cns_p148_q101","topicId":"cns_p148","difficulty":"standard","type":"choice","prompt":"小车方向盘连接的轴不变，换较大的方向盘，转向通常怎样？","choices":[{"key":"A","text":"同样转向阻力下更省力"},{"key":"B","text":"转向轴的阻力一定消失"},{"key":"C","text":"小车质量必减半"},{"key":"D","text":"只能改变颜色"}],"answer":"A","explanation":"用较大的轮带动同一轴，施力位置离轴心更远，通常更省力。","verify":"\"同样转向阻力下更省力\"","level":"pro","origin":"original"},{"id":"cns_p148_q102","topicId":"cns_p148","difficulty":"standard","type":"choice","prompt":"比较两种方向盘的省力效果，应该控制什么？","choices":[{"key":"A","text":"方向盘直径相同"},{"key":"B","text":"小车停放地点的名称"},{"key":"C","text":"方向盘外形装饰相同即可"},{"key":"D","text":"轴和转向阻力相同"}],"answer":"D","explanation":"考查轮半径的作用，应保持轴和阻力一致，只改变轮的大小。","verify":"\"轴和转向阻力相同\"","level":"pro","origin":"original"},{"id":"cns_p148_q103","topicId":"cns_p148","difficulty":"challenge","type":"choice","prompt":"用螺丝刀转紧同一个螺丝，换粗一些的手柄通常更省力，利用了什么？","choices":[{"key":"A","text":"动滑轮，螺丝是滑轮"},{"key":"B","text":"浮力，手柄排开水"},{"key":"C","text":"轮轴，手柄相当于较大的轮"},{"key":"D","text":"斜面，手柄越粗坡越陡"}],"answer":"C","explanation":"螺丝刀手柄与杆构成轮轴，较粗手柄便于用较小力产生转动效果。","verify":"\"轮轴，手柄相当于较大的轮\"","level":"pro","origin":"original"}]
