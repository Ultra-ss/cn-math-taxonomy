[{"id":"cns_p124_q101","topicId":"cns_p124","difficulty":"standard","type":"choice","prompt":"剖开一个成熟豆荚，看到多粒豆子，豆荚和豆子在植物繁殖中分别是什么？","choices":[{"key":"A","text":"种子和土壤"},{"key":"B","text":"果实和种子"},{"key":"C","text":"两者都是根"},{"key":"D","text":"两者都是花瓣"}],"answer":"B","explanation":"豆荚整体是果实，内部的豆子是种子，观察时要区分包裹结构与内部种子。","verify":"\"果实和种子\"","level":"pro","origin":"original"},{"id":"cns_p124_q102","topicId":"cns_p124","difficulty":"standard","type":"choice","prompt":"某种植物的两朵花，子房内胚珠数不同，其他过程正常，果实中种子数可能怎样？","choices":[{"key":"A","text":"种子全部由花瓣变成"},{"key":"B","text":"只有果实外壳才由胚珠变成"},{"key":"C","text":"可能不同，种子由胚珠发育而来"},{"key":"D","text":"一定完全相同，与胚珠无关"}],"answer":"C","explanation":"胚珠有形成种子的可能，数目不同可影响种子数，但并非每个胚珠都一定成为成熟种子。","verify":"\"可能不同，种子由胚珠发育而来\"","level":"pro","origin":"original"},{"id":"cns_p124_q103","topicId":"cns_p124","difficulty":"challenge","type":"choice","prompt":"花图中要用箭头表示发育关系，哪组较准确？","choices":[{"key":"A","text":"子房→果实，胚珠→种子"},{"key":"B","text":"胚珠→果实，子房→种子"},{"key":"C","text":"花瓣→果实，花药→种子"},{"key":"D","text":"子房→种子，柱头→果实"}],"answer":"A","explanation":"果实主要由子房发育，种子由胚珠发育，不能把花瓣、根等任意连为种子来源。","verify":"\"子房→果实，胚珠→种子\"","level":"pro","origin":"original"}]
