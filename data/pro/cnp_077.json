[{"id":"cnp_077_q101","topicId":"cnp_077","difficulty":"standard","type":"numeric","prompt":"10 Ω 电阻通过 0.30 A 电流持续 2 min，产生的热量为多少 J？只填数值。","answer":"108","explanation":"焦耳定律 Q=I²Rt=0.30²×10×120=108 J。","level":"pro","origin":"original","verify":"0.3**2*10*2*60","sourceRefs":["gd2020"]},{"id":"cnp_077_q102","topicId":"cnp_077","difficulty":"standard","type":"choice","prompt":"粗导线与电炉丝串联，电流相同，电炉丝很热而导线温升小。主要原因是什么？","answer":"A","explanation":"相同电流、相同时间下，Q=I²Rt，电阻较大的电炉丝产生热量更多。导线也会发热，但通常电阻较小。","level":"pro","origin":"original","choices":[{"key":"A","text":"电炉丝电阻较大，相同时间产生热量更多"},{"key":"B","text":"导线不会产生任何热量"},{"key":"C","text":"电炉丝的电流必定比导线大"},{"key":"D","text":"导线中没有电流"}],"verify":"'电炉丝电阻较大，相同时间产生热量更多'","sourceRefs":["gd2020"]},{"id":"cnp_077_q103","topicId":"cnp_077","difficulty":"challenge","type":"choice","prompt":"两电阻 R甲=4 Ω、R乙=8 Ω 串联，通电相同时间，甲产生的热量与乙之比为多少？","answer":"D","explanation":"串联电流相同、通电时间相同，Q甲/Q乙=R甲/R乙=4/8=1/2。","level":"pro","origin":"original","choices":[{"key":"A","text":"4∶1"},{"key":"B","text":"1∶4"},{"key":"C","text":"2∶1"},{"key":"D","text":"1∶2"}],"verify":"'1∶2'","sourceRefs":["gd2020"]},{"id":"cnp_077_q104","topicId":"cnp_077","difficulty":"challenge","type":"numeric","prompt":"同一电阻通过的电流增大到原来的 2 倍，通电时间缩短到原来的 1/2，电阻不变。产生热量变为原来的多少倍？只填数值。","answer":"2","explanation":"Q=I²Rt，变化倍数为 2²×1/2=2。","level":"pro","origin":"original","verify":"2**2/2","sourceRefs":["gd2020"]}]
