[{"id":"cnp_074_q101","topicId":"cnp_074","difficulty":"standard","type":"numeric","prompt":"电能表标有“1600 imp/(kW·h)”，某用电器单独工作 2 min，指示灯闪烁 80 次。消耗电能为多少 J？只填数值。","answer":"180000","explanation":"电能为 80/1600=0.05 kW·h，1 kW·h=3.6×10⁶ J，因此为 1.8×10⁵ J。","level":"pro","origin":"original","verify":"80/1600*3.6e6"},{"id":"cnp_074_q102","topicId":"cnp_074","difficulty":"standard","type":"choice","prompt":"一台电器接在 12 V 电源上，电流 0.50 A，持续工作 5 min。消耗电能是多少？","answer":"D","explanation":"t=5 min=300 s，W=UIt=12×0.50×300=1800 J。","level":"pro","origin":"original","choices":[{"key":"A","text":"30 J"},{"key":"B","text":"360 J"},{"key":"C","text":"3000 J"},{"key":"D","text":"1800 J"}],"verify":"'1800 J'"},{"id":"cnp_074_q103","topicId":"cnp_074","difficulty":"challenge","type":"numeric","prompt":"某月初电能表示数为 1268.4 kW·h，月末为 1321.9 kW·h，电价每 kW·h 0.6 元。该月电费是多少元？只填数值。","answer":"32.1","explanation":"用电量为 1321.9−1268.4=53.5 kW·h，电费为 53.5×0.6=32.1 元。","level":"pro","origin":"original","verify":"(1321.9-1268.4)*0.6"},{"id":"cnp_074_q104","topicId":"cnp_074","difficulty":"challenge","type":"choice","prompt":"关于电功和电能表，下列说法正确的是哪项？","answer":"C","explanation":"电能表记录累计消耗的电能，脉冲数与电能成正比；kW 是功率单位，kW·h 是能量单位，适用于各种功率电器。","level":"pro","origin":"original","choices":[{"key":"A","text":"电能表记录的是当前电功率"},{"key":"B","text":"电能表数字单位为 kW"},{"key":"C","text":"相同电能表中，指示灯累计闪烁次数越多，消耗电能越多"},{"key":"D","text":"1 kW·h 只适用于 1 kW 的电器"}],"verify":"'相同电能表中，指示灯累计闪烁次数越多，消耗电能越多'"}]
