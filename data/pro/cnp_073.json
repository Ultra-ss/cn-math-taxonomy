[{"id":"cnp_073_q101","topicId":"cnp_073","difficulty":"standard","type":"numeric","prompt":"6 Ω、12 Ω 两电阻并联接在 6 V 电源上。干路电流为多少 A？只填数值。","answer":"1.5","explanation":"两支路电流分别为 6/6=1 A、6/12=0.5 A，干路电流为 1.5 A。","level":"pro","origin":"original","verify":"6/6+6/12"},{"id":"cnp_073_q102","topicId":"cnp_073","difficulty":"standard","type":"choice","prompt":"10 Ω 定值电阻与变阻器串联接在 6 V 恒压电源上。变阻器接入阻值从 20 Ω 减到 10 Ω，定值电阻两端电压怎样变化？","answer":"A","explanation":"开始 I=6/(10+20)=0.2 A，定值电阻电压 2 V；后来 I=6/(10+10)=0.3 A，电压 3 V。","level":"pro","origin":"original","choices":[{"key":"A","text":"从 2 V 增到 3 V"},{"key":"B","text":"从 4 V 减到 3 V"},{"key":"C","text":"始终 6 V"},{"key":"D","text":"从 3 V 减到 2 V"}],"verify":"'从 2 V 增到 3 V'","sourceRefs":["gd2024"]},{"id":"cnp_073_q103","topicId":"cnp_073","difficulty":"challenge","type":"choice","prompt":"两只电阻串联时总电阻为 30 Ω，其中一只为 10 Ω；把这两只改为并联，其等效电阻与哪项相符？","answer":"A","explanation":"另一只为 20 Ω；并联总电阻 R=10×20/(10+20)=20/3 Ω，小于两支路中较小的 10 Ω。","level":"pro","origin":"original","choices":[{"key":"A","text":"小于 10 Ω"},{"key":"B","text":"介于 10 Ω 与 20 Ω 之间"},{"key":"C","text":"等于 30 Ω"},{"key":"D","text":"等于 10 Ω"}],"verify":"'小于 10 Ω'"},{"id":"cnp_073_q104","topicId":"cnp_073","difficulty":"challenge","type":"numeric","prompt":"20 Ω 和 30 Ω 两只电阻并联，干路电流为 0.50 A。电源电压为多少 V？只填数值。","answer":"6","explanation":"并联总电阻为 20×30/(20+30)=12 Ω，电源电压 U=I总R总=0.50×12=6 V。","level":"pro","origin":"original","verify":"0.5*(20*30/(20+30))"}]
