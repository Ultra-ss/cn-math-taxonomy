[{"id":"cnp_084_q101","topicId":"cnp_084","difficulty":"standard","type":"choice","prompt":"直流电动机模型中，保持磁场方向不变，把线圈电流方向反向，转动方向通常怎样变化？","answer":"A","explanation":"通电导体在磁场中受力方向与电流方向有关，只改变电流方向会使受力和转动方向反向。","level":"pro","origin":"original","choices":[{"key":"A","text":"反向"},{"key":"B","text":"与电流方向无关"},{"key":"C","text":"一定停止且永不启动"},{"key":"D","text":"保持不变"}],"verify":"'反向'","sourceRefs":["gd2020"]},{"id":"cnp_084_q102","topicId":"cnp_084","difficulty":"standard","type":"choice","prompt":"若把电动机线圈的电流方向和外磁场方向同时反向，其他条件不变，转动方向通常怎样？","answer":"C","explanation":"电流和磁场两者同时反向，相当于受力方向反向两次，结果受力及转动方向保持不变。","level":"pro","origin":"original","choices":[{"key":"A","text":"只由磁体颜色决定"},{"key":"B","text":"一定不再受力"},{"key":"C","text":"保持原来方向"},{"key":"D","text":"一定反向"}],"verify":"'保持原来方向'"},{"id":"cnp_084_q103","topicId":"cnp_084","difficulty":"challenge","type":"choice","prompt":"直流电动机换向器的主要作用是什么？","answer":"B","explanation":"换向器在线圈经过平衡位置附近时改变线圈电流方向，使线圈受到的力继续产生同方向转动效果。","level":"pro","origin":"original","choices":[{"key":"A","text":"使外部电源始终断路"},{"key":"B","text":"在线圈经过特定位置时改变线圈中的电流方向，使转动得以持续"},{"key":"C","text":"使磁体永远失去磁性"},{"key":"D","text":"增加电源储存的化学能"}],"verify":"'在线圈经过特定位置时改变线圈中的电流方向，使转动得以持续'","sourceRefs":["gd2020"]},{"id":"cnp_084_q104","topicId":"cnp_084","difficulty":"challenge","type":"numeric","prompt":"某电动机输入电能 500 J，其中 350 J 转化为有用机械能，其余主要为内能。能量转化效率为百分之多少？只填数值。","answer":"70","explanation":"η=E有用机械/E输入=350/500=0.70=70%。","level":"pro","origin":"original","verify":"350/500*100","percent":true}]
